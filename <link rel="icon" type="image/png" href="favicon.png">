        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.6rem;
            color: var(--neutral-900) !important;
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
        }

        .nav-link {
            font-weight: 500;
            color: var(--neutral-700) !important;
            margin: 0 0.25rem;
            padding: 0.5rem 1rem !important;
            border-radius: 30px;
            transition: all 0.2s;
        }

        .nav-link:hover, .nav-link.active {
            background-color: var(--serene-soft);
            color: var(--serene-primary) !important;
        }

        .btn {
            font-weight: 600;
            padding: 0.6rem 1.5rem;
            border-radius: 40px;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.9rem;
            border: none;
        }

        .btn-primary {
            background-color: var(--serene-primary);
            color: white;
        }

        .btn-primary:hover {
            background-color: #1f5236;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(44,110,73,0.2);
        }

        .btn-secondary {
            background-color: var(--serene-secondary);
            color: white;
        }

        .btn-secondary:hover {
            background-color: #3a7a6f;
            color: white;
        }

        .btn-neutral {
            background-color: var(--neutral-200);
            color: var(--neutral-800);
        }

        .btn-neutral:hover {
            background-color: var(--neutral-300);
            color: var(--neutral-900);
        }

        .card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.02);
            transition: all 0.3s;
            background-color: white;
            border-top: 5px solid transparent;
        }

        .card:hover {
            box-shadow: 0 15px 35px rgba(44,110,73,0.06);
            border-top: 5px solid var(--serene-primary);
        }

        .badge-sereno {
            background-color: var(--serene-primary);
            color: white;
            font-weight: 600;
            padding: 0.5rem 1.2rem;
            border-radius: 50px;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .badge-light {
            background-color: var(--serene-soft);
            color: var(--neutral-700);
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-size: 0.8rem;
        }

        .section-title {
            position: relative;
            margin-bottom: 2rem;
            font-weight: 700;
            color: var(--neutral-900);
        }

        .section-title:after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 0;
            width: 70px;
            height: 5px;
            background-color: var(--serene-primary);
            border-radius: 3px;
        }

        .law-quote {
            background-color: var(--serene-soft);
            border-left: 8px solid var(--serene-secondary);
            padding: 1.5rem;
            border-radius: 12px;
            font-style: normal;
        }

        .jurisprudencia-card {
            background: linear-gradient(145deg, #ffffff, var(--serene-soft));
            border: 2px dashed var(--serene-primary);
            border-radius: 24px;
            padding: 1.8rem;
            margin: 2rem 0;
        }

        .footer {
            background-color: white;
            border-top: 3px solid var(--serene-primary);
            color: var(--neutral-600);
            padding: 3rem 0 2rem;
            margin-top: 4rem;
        }

        .footer h5 {
            color: var(--neutral-800);
            margin-bottom: 1.2rem;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
        }

        .footer a {
            color: var(--neutral-600);
            text-decoration: none;
            transition: color 0.2s;
        }

        .footer a:hover {
            color: var(--serene-primary);
            text-decoration: underline;
        }

        .colectivo-card {
            background: linear-gradient(145deg, #ffffff, var(--serene-light));
            border-radius: 28px;
            padding: 2rem;
            height: 100%;
            border: 1px solid rgba(44,110,73,0.1);
        }

        .form-control, .form-select {
            border-radius: 12px;
            border: 1px solid var(--neutral-300);
            padding: 0.75rem 1rem;
            background-color: white;
            transition: 0.2s;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--serene-primary);
            box-shadow: 0 0 0 3px rgba(44,110,73,0.1);
        }

        .modal-content {
            border-radius: 24px;
            border: 2px solid var(--serene-secondary);
        }

        .preview-area {
            background-color: var(--neutral-100);
            border-radius: 16px;
            padding: 1.5rem;
            font-family: 'Courier New', monospace;
            font-size: 0.9rem;
            white-space: pre-wrap;
            border: 1px solid var(--neutral-300);
            max-height: 400px;
            overflow-y: auto;
        }

        @media (max-width: 768px) {
            .navbar-brand {
                font-size: 1.2rem;
                flex-wrap: wrap;
            }
            .logo-mb {
                margin-bottom: 0.5rem;
            }
        }
    </style>
</head>
<body>

