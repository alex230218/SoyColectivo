<!-- ======= CONTENIDO PRINCIPAL ======= -->
<main class="container py-5">

    <!-- ======= HERO ======= -->
    <section id="inicio" class="row align-items-center g-5 mb-5 pb-4">
        <div class="col-lg-7">
            <span class="badge-sereno mb-3 d-inline-block"><i class="fas fa-gavel me-1"></i> Ley General de Desaparición · Artículo 119</span>
            <h1 class="display-4 fw-bold mb-4" style="color: var(--neutral-900);">Primeras horas: <br><span style="color: var(--serene-primary);">la diferencia entre la vida y la ausencia.</span></h1>
            <p class="lead fs-4 mb-4 text-secondary">Las <strong>72 horas de espera son un mito ilegal</strong>. <strong style="color: var(--serene-primary);">SoyColectivo</strong> te brinda las herramientas jurídicas para exigir búsqueda inmediata ante cualquier autoridad en Jalisco y México.</p>
            <div class="d-flex flex-wrap gap-3">
                <a href="#herramienta-familias" class="btn btn-primary py-3 px-4"><i class="fas fa-file-pdf me-2"></i>Generar denuncia / amparo</a>
                <a href="#colectivos" class="btn btn-secondary py-3 px-4"><i class="fas fa-people-line me-2"></i>Recursos para colectivos</a>
            </div>
            <p class="mt-4 small text-secondary"><i class="fas fa-circle-info me-1"></i> Sin costo, sin registro. Información basada en los Protocolos Homologados de Búsqueda.</p>
        </div>
        <div class="col-lg-5">
            <div class="card p-4 bg-white border-0 shadow-sm" style="border-top: 5px solid var(--serene-primary);">
                <div class="d-flex align-items-center mb-3">
                    <i class="fas fa-circle-exclamation fs-1 me-3" style="color: var(--serene-primary);"></i>
                    <div>
                        <h3 class="h5 fw-bold mb-1">¿Por qué es urgente?</h3>
                        <p class="mb-0 small">El 80% de las personas localizadas con vida se encuentran en las primeras 48 horas.</p>
                    </div>
                </div>
                <hr class="my-3">
                <div class="d-flex align-items-center">
                    <i class="fas fa-check-circle fs-1 me-3" style="color: var(--serene-secondary);"></i>
                    <div>
                        <h3 class="h5 fw-bold mb-1">Documento legalmente válido</h3>
                        <p class="mb-0 small">Cita artículos de la Ley General, Protocolo Homologado y Jurisprudencia obligatoria.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ======= GENERADOR DE DENUNCIAS ======= -->
    <section id="herramienta-familias" class="py-5">
        <div class="d-flex align-items-center gap-3 mb-4">
            <h2 class="section-title h1 fw-semibold" style="margin-bottom: 1.5rem;"><i class="fas fa-file-lines me-3" style="color: var(--serene-primary);"></i>Generador de denuncia / amparo</h2>
            <span class="badge-sereno">uso exclusivo para familias</span>
        </div>
        <div class="row">
            <div class="col-lg-8">
                <div class="card p-4">
                    <form id="disappearanceForm" class="row g-4">
                        <!-- Datos del denunciante -->
                        <h3 class="h5 fw-bold mb-0"><i class="fas fa-user-circle me-2" style="color: var(--serene-primary);"></i>Quién reporta</h3>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nombre completo *</label>
                            <input type="text" class="form-control" id="reporterName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Parentesco *</label>
                            <select class="form-select" id="reporterRelation" required>
                                <option value="" selected disabled>Selecciona</option>
                                <option>Madre / Padre</option>
                                <option>Hermano/a</option>
                                <option>Hijo/a</option>
                                <option>Cónyuge</option>
                                <option>Tutor legal</option>
                                <option>Otro familiar</option>
                                <option>Amigo/a</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Teléfono *</label>
                            <input type="tel" class="form-control" id="reporterPhone" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Correo electrónico</label>
                            <input type="email" class="form-control" id="reporterEmail">
                        </div>

                        <!-- Datos de la persona desaparecida -->
                        <h3 class="h5 fw-bold mt-3 mb-0"><i class="fas fa-user-large me-2" style="color: var(--serene-primary);"></i>Persona desaparecida</h3>
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">Nombre completo *</label>
                            <input type="text" class="form-control" id="missingName" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Edad *</label>
                            <input type="number" class="form-control" id="missingAge" min="0" max="120" required>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Género *</label>
                            <select class="form-select" id="missingGender" required>
                                <option>Mujer</option>
                                <option>Hombre</option>
                                <option>Otro</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Fecha de desaparición *</label>
                            <input type="date" class="form-control" id="disappearanceDate" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hora aproximada *</label>
                            <input type="time" class="form-control" id="disappearanceTime" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Lugar de desaparición *</label>
                            <input type="text" class="form-control" id="disappearancePlace" placeholder="Calle, colonia, municipio, referencias" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Vestimenta al momento</label>
                            <textarea class="form-control" id="lastClothing" rows="2" placeholder="ropa, calzado, accesorios..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Características físicas y señas particulares *</label>
                            <textarea class="form-control" id="physicalFeatures" rows="2" placeholder="estatura, complexión, tatuajes, cicatrices, lunares..." required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Contexto de la desaparición *</label>
                            <textarea class="form-control" id="disappearanceContext" rows="3" placeholder="¿Con quién estaba? ¿Qué hacía? ¿Hubo testigos?" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Información adicional relevante</label>
                            <textarea class="form-control" id="additionalInfo" rows="2" placeholder="enfermedades, medicamentos, posibles destinos..."></textarea>
                        </div>
                        <div class="col-12 d-flex justify-content-between mt-4">
                            <button type="button" id="generateDocsBtn" class="btn btn-primary px-5 py-3"><i class="fas fa-file-pdf me-2"></i>Generar documentos legales</button>
                            <button type="button" id="clearFormBtn" class="btn btn-neutral px-5"><i class="fas fa-eraser me-2"></i>Limpiar</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="colectivo-card">
                    <i class="fas fa-scale-balanced fs-1 mb-3" style="color: var(--serene-primary);"></i>
                    <h3 class="h4 fw-bold">Fundamento jurídico</h3>
                    <p class="text-secondary">Su denuncia no puede ser rechazada ni postergada.</p>
                    <div class="law-quote mt-4">
                        <p class="mb-2 fw-bold">Artículo 119 — Ley General:</p>
                        <p class="small">"Las autoridades deberán iniciar de inmediato la búsqueda y localización de personas desaparecidas, sin que pueda condicionarse a la espera de ningún plazo..."</p>
                    </div>
                    <hr class="my-4">
                    <p class="small text-secondary"><i class="fas fa-info-circle me-1"></i> Los documentos generados incluyen una solicitud de amparo indirecto en caso de omisión.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ======= SECCIÓN EXCLUSIVA PARA COLECTIVOS ======= -->
    <section id="colectivos" class="py-5 mt-5">
        <div class="row mb-5">
            <div class="col-lg-6">
                <h2 class="section-title h1 fw-semibold"><i class="fas fa-people-arrows me-3" style="color: var(--serene-primary);"></i>Espacio para colectivos</h2>
                <p class="fs-5 text-secondary">Herramientas, redes y apoyo jurídico para organizaciones de familiares y buscadores.</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 p-4 text-center border-0 shadow-sm">
                    <div class="d-flex justify-content-center mb-3">
                        <span class="bg-light p-3 rounded-circle"><i class="fas fa-map-location-dot fs-2" style="color: var(--serene-primary);"></i></span>
                    </div>
                    <h3 class="h5 fw-bold">Directorio activo</h3>
                    <p class="small text-secondary">Consulta colectivos de búsqueda en Jalisco y occidente. Acceso a contactos directos.</p>
                    <button class="btn btn-neutral w-100 mt-2" data-bs-toggle="modal" data-bs-target="#directorioModal">Ver colectivos</button>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 p-4 text-center border-0 shadow-sm">
                    <div class="d-flex justify-content-center mb-3">
                        <span class="bg-light p-3 rounded-circle"><i class="fas fa-chalkboard-user fs-2" style="color: var(--serene-primary);"></i></span>
                    </div>
                    <h3 class="h5 fw-bold">Guías jurídicas</h3>
                    <p class="small text-secondary">Protocolos, reformas y argumentación legal para litigio estratégico en desaparición.</p>
                    <button class="btn btn-neutral w-100 mt-2" data-bs-toggle="modal" data-bs-target="#guiasModal">Descargar PDF</button>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 p-4 text-center border-0 shadow-sm">
                    <div class="d-flex justify-content-center mb-3">
                        <span class="bg-light p-3 rounded-circle"><i class="fas fa-hand-holding-hand fs-2" style="color: var(--serene-primary);"></i></span>
                    </div>
                    <h3 class="h5 fw-bold">Acompañamiento</h3>
                    <p class="small text-secondary">Vinculación con abogadas/os especializadas en amparo y litigio ante la CIDH.</p>
                    <button class="btn btn-neutral w-100 mt-2">Solicitar apoyo</button>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 p-4 text-center border-0 shadow-sm">
                    <div class="d-flex justify-content-center mb-3">
                        <span class="bg-light p-3 rounded-circle"><i class="fas fa-plus-circle fs-2" style="color: var(--serene-primary);"></i></span>
                    </div>
                    <h3 class="h5 fw-bold">Registra tu colectivo</h3>
                    <p class="small text-secondary">Súmate a SoyColectivo para visibilizar tu labor y acceder a herramientas gratuitas.</p>
                    <button class="btn btn-primary w-100 mt-2" data-bs-toggle="modal" data-bs-target="#registroColectivoModal">Registrar ahora</button>
                </div>
            </div>
        </div>
        <div class="row mt-5">
            <div class="col-12">
                <div class="law-quote p-4 d-flex flex-wrap align-items-center justify-content-between">
                    <div>
                        <i class="fas fa-quote-left fs-1 me-2" style="color: var(--serene-primary);"></i>
                        <span class="fs-6 fw-medium">El Protocolo Homologado de Búsqueda faculta a los colectivos para coadyuvar en tareas de localización y tener acceso a carpetas de investigación.</span>
                    </div>
                    <span class="badge-sereno mt-2 mt-lg-0"><i class="fas fa-book-open me-1"></i> Protocolo, art. 42</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ======= RECURSOS LEGALES CON JURISPRUDENCIA (ENFOQUE REDES SOCIALES) ======= -->
    <section id="recursos" class="py-5">
        <h2 class="section-title h2 fw-semibold"><i class="fas fa-gavel me-3" style="color: var(--serene-primary);"></i>Recursos legales / Jalisco</h2>
        
        <!-- JURISPRUDENCIA DESTACADA -->
        <div class="jurisprudencia-card mb-5">
            <div class="d-flex align-items-start gap-4">
                <div>
                    <span class="badge-sereno mb-3">JURISPRUDENCIA OBLIGATORIA 2024</span>
                    <h3 class="h4 fw-bold" style="color: var(--serene-primary);">1a./J. 14/2024 (11a.)</h3>
                    <p class="fw-semibold">EJERCICIO DEL DERECHO DE PETICIÓN. UNA VEZ QUE LA AUTORIDAD ACEPTA QUE HA RECIBIDO UNA PETICIÓN, QUEDA OBLIGADA A DICTAR ACUERDO SOBRE ÉSTA.</p>
