    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter (legible) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* ===== PALETA SERENA ===== */
        :root {
            --serene-primary: #2c6e49;      /* Verde bosque, calma, esperanza */
            --serene-secondary: #4c9a8c;    /* Verde azulado, serenidad */
            --serene-light: #f4f1e9;        /* Beige suave, fondo acogedor */
            --serene-soft: #e8eae6;         /* Gris verdoso muy claro */
            --serene-accent: #d4b5b0;       /* Rosa terroso, empatía */
            --neutral-100: #faf9f7;
            --neutral-200: #f0efeb;
            --neutral-300: #e2dfd9;
            --neutral-400: #b8b2aa;
            --neutral-500: #9c948c;
            --neutral-600: #6b625a;
            --neutral-700: #4a4540;
            --neutral-800: #2e2a27;
            --neutral-900: #1e1b18;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--serene-light);
            color: var(--neutral-800);
            line-height: 1.6;
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 600;
            letter-spacing: -0.01em;
        }

        .navbar {
            background-color: white !important;
            box-shadow: 0 4px 20px rgba(44,110,73,0.08);
            padding: 0.75rem 0;
            border-bottom: 3px solid var(--serene-primary);
        }

        /* ===== NUEVO LOGO CON LA FRASE ===== */
        .logo-mb {
            font-family: 'Inter', sans-serif;
            font-weight: 700;
            line-height: 1.2;
            text-align: left;
            color: var(--serene-primary);
            background-color: var(--serene-soft);
            padding: 0.5rem 1rem;
            border-radius: 12px;
            margin-right: 1rem;
            border-left: 6px solid var(--serene-secondary);
        }
        .logo-mb .primera-linea {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--neutral-600);
        }
        .logo-mb .segunda-linea {
            font-size: 1rem;
            font-weight: 800;
            color: var(--serene-primary);
        }
        .logo-mb .tercera-linea {
